# Express Backend Configuration Template
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Connection to Django REST Backend
DJANGO_BASE_URL=http://localhost:8000

# Optional: MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/binance_db?retryWrites=true&w=majority

# Optional: Google Gemini API Key for AI Deep Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Live Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_BASE_URL=https://api.binance.com
